{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id482110046"}, "name":{"label":"airjohnpro"}, "label":""}, "updated":{"label":"2019-06-15T08:35:06-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.0.3"}, "id":{"label":"4320195488"}, "title":{"label":"Wow! So many use case..."}, "content":{"label":"This app is great for work, study, relaxing and more. The devs are super passionate as is the community. Definitely check them out!\n\nThe music is high quality, with a nice variety of beats. Can’t wait to personalize more with likes and favs. \n\nLooks great on the iPhone and there’s an AppleTV app as well!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1154429580&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
