{"author":{"uri":{"label":"https://itunes.apple.com/de/reviews/id114047239"}, "name":{"label":"spoldi"}, "label":""}, "updated":{"label":"2025-07-09T13:26:58-07:00"}, "im:rating":{"label":"4"}, "im:version":{"label":"4.50.5"}, "id":{"label":"12872600592"}, "title":{"label":"Gut aber…"}, "content":{"label":"Ich verwende Endel schon seit einigen Monaten. Hauptsächlich die Sleep Funktion finde ich richtig schön angenehm, wäre nicht immer das abrupte Ende. Wann endlich kommt ein weiches Fade out nach der eingestellten Zeit?", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/de/review?id=1346247457&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Programm"}}, "im:voteCount":{"label":"0"}}, 
