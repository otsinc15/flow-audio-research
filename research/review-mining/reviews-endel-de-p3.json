{"author":{"uri":{"label":"https://itunes.apple.com/de/reviews/id176648308"}, "name":{"label":"Chrwe"}, "label":""}, "updated":{"label":"2025-06-26T18:29:59-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"4.50.3"}, "id":{"label":"12821559901"}, "title":{"label":"Beware"}, "content":{"label":"They say you get a 7 days free trial. I immediately was charged 59 Eur for this free trial! There was no “trial” involved at all, I was just charged the full outrageous amount. And yes, I opted for the trial and canceled immediately as I always do with trials. Obviously this is set up wrong.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/de/review?id=1346247457&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Programm"}}, "im:voteCount":{"label":"0"}}, 
