{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id168778381"}, "name":{"label":"JK Mpls"}, "label":""}, "updated":{"label":"2019-09-19T07:55:57-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.1"}, "id":{"label":"4804573915"}, "title":{"label":"Great design and sounds!"}, "content":{"label":"This is just the simple noise app I was looking for — easy to use, and a classic selection of sounds. I love the ability to set up a widget for easy access. The only feature I’d love to see in a future release is to have the noise automatically fade out when interrupted by an alarm or sound from another app. Thanks!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1465439395&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
