{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id43191839"}, "name":{"label":"Choley Oley"}, "label":""}, "updated":{"label":"2024-01-20T13:39:19-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.2.6"}, "id":{"label":"10844806170"}, "title":{"label":"Helps My Insomnia!"}, "content":{"label":"I am a combat veteran with PTSD and have trouble falling asleep. I’ve tried a ton of things including prescribed medications that haven’t worked consistently or for very long. But the custom sound I’ve made in the premium version of this app lulls me to sleep in a Pavlovian way. And it helps keep me asleep. I’m so, so grateful for this app. Thank you Charlie Chapman.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1465439395&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
