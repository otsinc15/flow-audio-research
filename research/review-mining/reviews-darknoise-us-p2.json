{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id37078527"}, "name":{"label":"turningfortune.com"}, "label":""}, "updated":{"label":"2023-12-20T05:09:53-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.2.3"}, "id":{"label":"10722397166"}, "title":{"label":"The ideal noise app"}, "content":{"label":"Dark Noise is an app I have wished for for the entire existence of the iPhone, and I'm so glad it exists. My only complaint is that the wind chimes sample is way too short and repetitive; if that ever gets fixed, the app will be perfect for me.\n\nI'd also love a native watch app that works without the phone present.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1465439395&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
