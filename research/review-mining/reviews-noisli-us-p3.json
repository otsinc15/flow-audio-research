{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id23092406"}, "name":{"label":"ThatShortChicky"}, "label":""}, "updated":{"label":"2015-10-15T20:06:10-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.1.1"}, "id":{"label":"1272257533"}, "title":{"label":"My favorite napping app"}, "content":{"label":"I take at least one timed app every day and this app is the best white noise app that I have found. There's no nonsense of buying this or that; you can blend sounds together as you wish and you can set a timer to fade out or stop at the end of your nap. I've been using it for almost a year now and I cannot find anything to complain about.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=862773459&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
