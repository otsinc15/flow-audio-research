{"author":{"uri":{"label":"https://itunes.apple.com/de/reviews/id31017791"}, "name":{"label":"CassiRhubarb"}, "label":""}, "updated":{"label":"2022-02-26T17:09:22-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"3.4.16"}, "id":{"label":"8400136955"}, "title":{"label":"Scam!"}, "content":{"label":"If you cancel your subscription, you immediately lose access to /can’t listen to any tracks anymore, unlike any other apps where you can make use until your subscription period runs out. Wanna make sure you avoid auto renewal but make use of your subscription? Well… you better have very good timing! Customer support not helpful!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/de/review?id=1110684238&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Programm"}}, "im:voteCount":{"label":"0"}}, 
