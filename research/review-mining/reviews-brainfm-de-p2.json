{"author":{"uri":{"label":"https://itunes.apple.com/de/reviews/id124497499"}, "name":{"label":"Quanto1206"}, "label":""}, "updated":{"label":"2020-04-05T03:18:53-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"3.1.10"}, "id":{"label":"5765632948"}, "title":{"label":"Upgrade to paid but version but still no sessions available"}, "content":{"label":"Such thing a frustrating me! You want to work, upgrade and pay money, then the API is not working, app don’t get a signal that I am paid member already! \n\nThen, you want want to write feedback and then, they have no live chat! Guys it’s time to grow up and to be a real business not a baby app!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/de/review?id=1110684238&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Programm"}}, "im:voteCount":{"label":"0"}}, 
