{"author":{"uri":{"label":"https://itunes.apple.com/de/reviews/id389615056"}, "name":{"label":"Jlmsr1"}, "label":""}, "updated":{"label":"2018-06-06T02:12:39-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2.45.4"}, "id":{"label":"2649501849"}, "title":{"label":"Simply Amazing"}, "content":{"label":"The User Interface: Simple and intuitive design, warm colors and great user experience \n\nThe Product: very well thought through, great science to back it up and it works\n\nConclusion: often times companies have great tech but fail to design a great customer experience to live up to it. Brain.fm does and that makes it so good! A job well done", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/de/review?id=1110684238&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Programm"}}, "im:voteCount":{"label":"0"}}, 
