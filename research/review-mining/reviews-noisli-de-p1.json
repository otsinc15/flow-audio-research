{"author":{"uri":{"label":"https://itunes.apple.com/de/reviews/id485942849"}, "name":{"label":"Charlie Whitehouse"}, "label":""}, "updated":{"label":"2020-03-18T01:27:22-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.1.4"}, "id":{"label":"5676289190"}, "title":{"label":"Great for relaxing and for isolating yourself in a noisy office"}, "content":{"label":"Great application! I love it, especially the prop airplane and the train sound models. I use it both for relaxing and for covering the voices in the office when the colleagues need to discuss something together.\nAny noise suppression headphones cannot do this. I think it has to do with how our auditory system works. It’s much easier to blend out a human voice by listening to a repetitive sound.\nMany thanks to the developers!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/de/review?id=862773459&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Programm"}}, "im:voteCount":{"label":"0"}}, 
