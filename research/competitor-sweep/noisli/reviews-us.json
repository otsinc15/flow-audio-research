{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id209587221"}, "name":{"label":"youjustme73"}, "label":""}, "updated":{"label":"2020-02-05T09:58:19-07:00"}, "im:rating":{"label":"3"}, "im:version":{"label":"1.1.4"}, "id":{"label":"5491908886"}, "title":{"label":"Needs improvement"}, "content":{"label":"The app is easy to use. The sounds are great and definitely relaxing. The background changes color on its own to pale colors meanwhile the text is white. This makes it very hard to see. The app uses very thin fonts that don’t adhere to Apple accessibility standards so the text is hard to read. I would prefer that we are able to select a static background color instead of it changing all the time. Pale mint color on white text basically makes the text disappear.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=862773459&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
